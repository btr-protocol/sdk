{
  "name": "@btr-protocol/sdk",
  "version": "0.7.0",
  "main": "./src/index.ts",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "1.3.13",
    "@types/node": "^20.10.0",
    "@typescript/native-preview": "^7.0.0-dev.20251227.1"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "bin": {
    "btr": "bin/btr.js",
    "btr-mcp": "bin/btr-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./abis": {
      "types": "./src/abis/index.ts",
      "default": "./src/abis/index.ts"
    },
    "./amm": {
      "types": "./src/amm/index.ts",
      "default": "./src/amm/index.ts"
    },
    "./eth": {
      "types": "./src/eth/index.ts",
      "default": "./src/eth/index.ts"
    },
    "./oracle": {
      "types": "./src/oracle/index.ts",
      "default": "./src/oracle/index.ts"
    },
    "./governance": {
      "types": "./src/governance/index.ts",
      "default": "./src/governance/index.ts"
    },
    "./eth/gas": {
      "types": "./src/eth/gas.ts",
      "default": "./src/eth/gas.ts"
    },
    "./eth/wallets": {
      "types": "./src/eth/wallets.ts",
      "default": "./src/eth/wallets.ts"
    },
    "./pool": {
      "types": "./src/pool/index.ts",
      "default": "./src/pool/index.ts"
    },
    "./pool/slippage": {
      "types": "./src/pool/slippage.ts",
      "default": "./src/pool/slippage.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    },
    "./venues": {
      "types": "./src/venues/index.ts",
      "default": "./src/venues/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/format": {
      "types": "./src/utils/format.ts",
      "default": "./src/utils/format.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./utils/logger": {
      "types": "./src/utils/logger.ts",
      "default": "./src/utils/logger.ts"
    }
  },
  "description": "Lightweight EVM RPC + ABIs + contract helpers for BTR (front, back, keepers, contracts)",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "abis",
    "abis.lock.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "bin"
  ],
  "keywords": [
    "btr",
    "evm",
    "rpc",
    "abi",
    "dex",
    "amm",
    "oracle",
    "mcp",
    "model-context-protocol",
    "bun"
  ],
  "scripts": {
    "build": "bun run fetch-abis && bun build ./src/index.ts --outdir ./dist --target node",
    "check": "bun run typecheck && bun test",
    "dev": "bunx tsgo -p tsconfig.json --watch --noEmit",
    "fetch-abis": "bun scripts/gen-constants.ts && bun scripts/gen-venues.ts && bun scripts/gen-rpcs.ts && bun scripts/gen-nxr-marks.ts && bun scripts/fetch-abis.ts",
    "format": "bunx biome format --write src",
    "refresh-rpcs": "bun scripts/refresh-rpcs.ts",
    "lint": "bunx biome check src",
    "test": "bun run fetch-abis && bun test",
    "typecheck": "bun run fetch-abis && bunx tsgo -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run fetch-abis && bun run typecheck && bun test ./src ./test"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts",
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btr-protocol/sdk.git"
  },
  "homepage": "https://github.com/btr-protocol/sdk#readme",
  "bugs": {
    "url": "https://github.com/btr-protocol/sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.btr-protocol/btr-mcp"
}
